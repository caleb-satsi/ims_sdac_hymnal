{
  "name": "international-hymnal-sdac",
  "productName": "International Hymnal (SDAC)",
  "version": "1.0.0",
  "description": "International Hymnal (SDAC) — desktop edition",
  "author": "Caleb Satsi Agbefia",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win appx",
    "dist:win-exe": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:mac-store": "electron-builder --mac mas",
    "dist": "electron-builder -mw"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.internationalhymnalsdac.app",
    "productName": "International Hymnal (SDAC)",
    "files": [
      "main.js",
      "app/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "build/afterPack.js",
    "win": {
      "target": [
        { "target": "appx", "arch": ["x64", "arm64"] }
      ],
      "icon": "build/icon.ico"
    },
    "appx": {
      "applicationId": "InternationalHymnalSDAC",
      "identityName": "InternationalHymnalSDAC",
      "publisher": "CN=REPLACE_WITH_YOUR_PARTNER_CENTER_PUBLISHER_ID",
      "publisherDisplayName": "REPLACE_WITH_YOUR_PUBLISHER_DISPLAY_NAME",
      "backgroundColor": "#153656",
      "showNameOnTiles": true,
      "languages": ["en-US"]
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "mas", "arch": ["universal"] }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.music"
    },
    "mas": {
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.plist"
    },
    "dmg": {
      "title": "International Hymnal (SDAC)"
    }
  }
}
